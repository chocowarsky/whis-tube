# Optional single API key (if not using ~/.config/groq/keys.json multi-key pool)
GROQ_API_KEY=gsk_your_api_key_here

# Custom path to keys.json (defaults to ~/.config/groq/keys.json)
# GROQ_KEYS_PATH=~/.config/groq/keys.json

# Whisper model override (default: whisper-large-v3)
# WHISPER_MODEL=whisper-large-v3

# In-process rate limit sleep budget in seconds (default: 900)
# GROQ_MAX_WAIT_S=900
